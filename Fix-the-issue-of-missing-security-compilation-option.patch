From 96fa6600c80add29c00add5999a397db3a1ddd01 Mon Sep 17 00:00:00 2001
From: tong_1001 <sxt1001@qq.com>
Date: Fri, 3 Jul 2026 10:54:41 +0800
Subject: [PATCH 5/6] Fix the issue of missing security compilation options

---
 src/libs/libxalarm/CMakeLists.txt                            | 4 ++--
 src/sentryPlugins/bmc_ras_sentry/CMakeLists.txt              | 3 +++
 .../cpu_sentry/catlib/plugin/cpu_patrol/CMakeLists.txt       | 5 +++++
 src/sentryPlugins/hbm_online_repair/Makefile                 | 4 ++--
 src/sentryPlugins/sentry_msg_monitor/Makefile                | 2 +-
 src/sentryPlugins/soc_ring_sentry/Makefile                   | 5 ++++-
 src/services/sentryCollector/ebpf_collector/Makefile         | 5 +++--
 7 files changed, 20 insertions(+), 8 deletions(-)

diff --git a/src/libs/libxalarm/CMakeLists.txt b/src/libs/libxalarm/CMakeLists.txt
index d5d16d491428..7f3f95158493 100644
--- a/src/libs/libxalarm/CMakeLists.txt
+++ b/src/libs/libxalarm/CMakeLists.txt
@@ -2,7 +2,7 @@
 # Description: cmake file for libxalarm
 add_library(xalarm SHARED register_xalarm.c)
 target_link_libraries(xalarm PRIVATE pthread -ljson-c)
-set_target_properties(xalarm PROPERTIES LINK_FLAGS "-Wl,-z,relro -Wl,-z,now -Wl,-z,noexecstack -Wtrampolines")
-set_target_properties(xalarm PROPERTIES CMAKE_C_FLAGS "-shared -fPIC -fstack-protector-strong -D_FORTIFY_SOURCE=2 -O2 -Wall -Werror -g")
+set_target_properties(xalarm PROPERTIES LINK_FLAGS "-Wl,-z,relro -Wl,-z,now -Wl,-z,noexecstack")
+set_target_properties(xalarm PROPERTIES CMAKE_C_FLAGS "-shared -fPIC -fstack-protector-strong -D_FORTIFY_SOURCE=2 -O2 -Wall -Werror -Wtrampolines -g")
  
 install(TARGETS xalarm LIBRARY DESTINATION ${XD_INSTALL_BINDIR})
diff --git a/src/sentryPlugins/bmc_ras_sentry/CMakeLists.txt b/src/sentryPlugins/bmc_ras_sentry/CMakeLists.txt
index 16260fc4b102..94fbb9d0c09c 100644
--- a/src/sentryPlugins/bmc_ras_sentry/CMakeLists.txt
+++ b/src/sentryPlugins/bmc_ras_sentry/CMakeLists.txt
@@ -9,6 +9,9 @@ set(CMAKE_RUNTIME_OUTPUT_DIRECTORY ${CMAKE_SOURCE_DIR}/output)
 set(CMAKE_SKIP_BUILD_RPATH TRUE)
 set(CMAKE_SKIP_INSTALL_RPATH TRUE)
 
+set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} -fstack-protector-strong -D_FORTIFY_SOURCE=2 -O2 -Wall -Wtrampolines -fPIE")
+set(CMAKE_EXE_LINKER_FLAGS "${CMAKE_EXE_LINKER_FLAGS} -Wl,-z,relro -Wl,-z,now -Wl,-z,noexecstack -pie")
+
 include_directories(
     ${CMAKE_SOURCE_DIR}/include
     ${CMAKE_SOURCE_DIR}/../../libs/libxalarm
diff --git a/src/sentryPlugins/cpu_sentry/catlib/plugin/cpu_patrol/CMakeLists.txt b/src/sentryPlugins/cpu_sentry/catlib/plugin/cpu_patrol/CMakeLists.txt
index bb9cc33f2ce8..3c21dd27c04d 100644
--- a/src/sentryPlugins/cpu_sentry/catlib/plugin/cpu_patrol/CMakeLists.txt
+++ b/src/sentryPlugins/cpu_sentry/catlib/plugin/cpu_patrol/CMakeLists.txt
@@ -11,3 +11,8 @@ link_directories(${CMAKE_SOURCE_DIR}/../../../libs/build/libxalarm/)
 
 TARGET_LINK_LIBRARIES(cpu_patrol pthread xalarm -ldl)
 
+set_target_properties(cpu_patrol PROPERTIES
+    COMPILE_FLAGS "-fPIC -fstack-protector-strong -D_FORTIFY_SOURCE=2 -O2 -Wall -Wtrampolines -g"
+    LINK_FLAGS "-Wl,-z,relro -Wl,-z,now -Wl,-z,noexecstack"
+)
+
diff --git a/src/sentryPlugins/hbm_online_repair/Makefile b/src/sentryPlugins/hbm_online_repair/Makefile
index 16ebcd8a960d..7fffbc679c9f 100644
--- a/src/sentryPlugins/hbm_online_repair/Makefile
+++ b/src/sentryPlugins/hbm_online_repair/Makefile
@@ -1,8 +1,8 @@
 CC = gcc
 
-CFLAGS = -Wall -o3
+CFLAGS += -Wall -Wtrampolines -O2 -g -fstack-protector-strong -D_FORTIFY_SOURCE=2 -fPIE
 
-LDFLAGS = -ltraceevent
+LDFLAGS += -Wl,-z,relro -Wl,-z,now -Wl,-z,noexecstack -pie -ltraceevent
 
 SRC = $(wildcard *.c)
 HDR = $(wildcard *.h)
diff --git a/src/sentryPlugins/sentry_msg_monitor/Makefile b/src/sentryPlugins/sentry_msg_monitor/Makefile
index 5025f54ff90e..e229d6bf43a7 100644
--- a/src/sentryPlugins/sentry_msg_monitor/Makefile
+++ b/src/sentryPlugins/sentry_msg_monitor/Makefile
@@ -24,7 +24,7 @@ else
 all: sentry_msg_monitor
 
 sentry_msg_monitor:
-	gcc sentry_msg_monitor.c ub_fault_lib.c bmc_log_lib.c -fstack-protector-strong -Wall -D_FORTIFY_SOURCE=2 -O2 -g -Wl,-z,relro -Wl,-z,now -fPIE -pie -I../../libsentry/c/log -L../../libsentry/c/log/build -I../../libs/libxalarm -L../../libs/build/libxalarm -lobmm -lxalarm -lsentry_log -ljson-c -pthread -o sentry_msg_monitor
+	gcc sentry_msg_monitor.c ub_fault_lib.c bmc_log_lib.c -fstack-protector-strong -Wall -D_FORTIFY_SOURCE=2 -O2 -g -Wl,-z,relro -Wl,-z,now -Wl,-z,noexecstack -Wtrampolines -fPIE -pie -I../../libsentry/c/log -L../../libsentry/c/log/build -I../../libs/libxalarm -L../../libs/build/libxalarm -lobmm -lxalarm -lsentry_log -ljson-c -pthread -o sentry_msg_monitor
 
 clean:
 	rm -f sentry_msg_monitor
diff --git a/src/sentryPlugins/soc_ring_sentry/Makefile b/src/sentryPlugins/soc_ring_sentry/Makefile
index 02032d970adb..316c262b5c14 100644
--- a/src/sentryPlugins/soc_ring_sentry/Makefile
+++ b/src/sentryPlugins/soc_ring_sentry/Makefile
@@ -1,7 +1,10 @@
+CFLAGS += -Wall -O2 -g -fstack-protector-strong -D_FORTIFY_SOURCE=2 -fPIE -Wtrampolines
+LDFLAGS += -Wl,-z,relro -Wl,-z,now -Wl,-z,noexecstack -pie
+
 all: soc_ring_sentry
 
 soc_ring_sentry:
-	gcc *.c -Wall -o3 -I../../libsentry/c/log -L../../libsentry/c/log/build -I../../libs/libxalarm -L../../libs/build/libxalarm -lxalarm -lsentry_log -ljson-c -pthread -lnuma -o soc_ring_sentry
+	gcc *.c $(CFLAGS) -I../../libsentry/c/log -L../../libsentry/c/log/build -I../../libs/libxalarm -L../../libs/build/libxalarm -lxalarm -lsentry_log -ljson-c -pthread -lnuma $(LDFLAGS) -o soc_ring_sentry
 
 clean:
 	rm -f soc_ring_sentry
diff --git a/src/services/sentryCollector/ebpf_collector/Makefile b/src/services/sentryCollector/ebpf_collector/Makefile
index 413d366447bd..f6c8df998820 100644
--- a/src/services/sentryCollector/ebpf_collector/Makefile
+++ b/src/services/sentryCollector/ebpf_collector/Makefile
@@ -7,7 +7,8 @@ ARCH := $(shell uname -m | sed 's/x86_64/x86/' | sed 's/aarch64/arm64/' | sed 's
 KERNEL_CFLAGS = -O2 -g -target bpf -D__TARGET_ARCH_$(ARCH)
 
 # 定义用户态编译选项
-USER_CFLAGS = -g -fstack-protector-strong -D_FORTIFY_SOURCE=2 -O2 -Wl,-z,relro,-z,now -lbpf
+USER_CFLAGS = -g -fstack-protector-strong -D_FORTIFY_SOURCE=2 -O2 -Wall -Wtrampolines -fPIE -Wl,-z,relro -Wl,-z,now -Wl,-z,noexecstack
+USER_LDFLAGS = -Wl,-z,relro -Wl,-z,now -Wl,-z,noexecstack -pie -lbpf
 
 # 定义目标文件
 KERNEL_TARGET = ebpf_collector.bpf.o
@@ -28,7 +29,7 @@ $(SKELETON_HEADER): $(KERNEL_TARGET)
 
 # 编译用户态文件
 $(USER_TARGET): ebpf_collector.c $(SKELETON_HEADER)
-	$(CC) $(USER_CFLAGS) $< -o $@
+	$(CC) $(USER_CFLAGS) $< -o $@ $(USER_LDFLAGS)
 
 # 清理生成的文件
 clean:
-- 
2.43.0


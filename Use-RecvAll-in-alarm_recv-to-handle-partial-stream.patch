From a1f2ec7095222ae859c6db7a4b2f819f796609d7 Mon Sep 17 00:00:00 2001
From: shixuantong <sxt1001@qq.com>
Date: Fri, 11 Sep 2026 16:20:41 +0800
Subject: [PATCH] Use RecvAll in alarm_recv to handle partial stream messages

register_fd is a SOCK_STREAM socket, but alarm_recv() did a single
recv(sizeof(struct alarm_info)). On a stream socket recv() may return
fewer bytes than requested (partial message). The old code silently
dropped that partial data and kept looping, leaving the remaining
bytes in the receive buffer: every subsequent message was parsed
misaligned, so corrupted alarm contents were delivered to the
application callback.

Use RecvAll() (already linked via libsentry_io and used by
xalarm_get_event) so each loop iteration consumes exactly one complete
message. RecvAll retries EINTR/EAGAIN internally; on connection close
(0) or an unrecoverable error (-1, e.g. ECONNRESET on a partial
message) stop the receive thread instead of busy spinning.

Co-Authored-By: GLM-5.3
---
 src/libs/libxalarm/register_xalarm.c | 23 ++++++++++++++---------
 1 file changed, 14 insertions(+), 9 deletions(-)

diff --git a/src/libs/libxalarm/register_xalarm.c b/src/libs/libxalarm/register_xalarm.c
index 5c5272a..8286e68 100644
--- a/src/libs/libxalarm/register_xalarm.c
+++ b/src/libs/libxalarm/register_xalarm.c
@@ -131,7 +131,6 @@ release_socket:
 
 static void *alarm_recv(void *arg)
 {
-    int recvlen = 0;
     struct alarm_info info;
     int ret = 0;
 
@@ -142,19 +141,25 @@ static void *alarm_recv(void *arg)
         return NULL;
     }
     while (!g_register_info.thread_should_stop) {
-        recvlen = recv(g_register_info.register_fd, &info, sizeof(struct alarm_info), 0);
-        if (recvlen == (int)sizeof(struct alarm_info)) {
+        /* register_fd is a stream socket: a single recv() may return a partial
+         * message and the leftover bytes would desync every subsequent message.
+         * RecvAll keeps reading until the whole alarm_info arrives (retrying on
+         * EINTR/EAGAIN internally), so each loop iteration consumes exactly one
+         * message.
+         */
+        ssize_t recvlen = RecvAll(g_register_info.register_fd, (char *)&info, sizeof(struct alarm_info));
+        if (recvlen == (ssize_t)sizeof(struct alarm_info)) {
             put_alarm_info(&info);
-        } else if (recvlen < 0) {
-            if (errno == EINTR || errno == EAGAIN || errno == EWOULDBLOCK) {
-                usleep(RECV_DELAY_MSEC * TIME_UNIT_MILLISECONDS);
-                continue;
-            }
-            printf("recv error len:%d errno:%d\n", recvlen, errno);
         } else if (recvlen == 0) {
             printf("connection closed by xalarmd, maybe connections reach max num or service stopped.\n");
             g_register_info.thread_should_stop = 1;
             break;
+        } else {
+            /* unrecoverable recv error (e.g. ECONNRESET on partial message,
+             * EBADF): the connection is broken, stop instead of busy spinning */
+            printf("recv error, errno:%d\n", errno);
+            g_register_info.thread_should_stop = 1;
+            break;
         }
     }
     return NULL;
-- 

From c0f3f0d7f3b1d5535af45b6014cd0726a978970d Mon Sep 17 00:00:00 2001
From: shixuantong <sxt1001@qq.com>
Date: Fri, 4 Sep 2026 15:12:22 +0800
Subject: [PATCH] Simplify io_type extraction in print_map_res

Replace the strlen-based check with a direct comparison of
counter.io_type[0] against '\0', which is equivalent and
avoids the redundant string length computation.
---
 .../sentryCollector/ebpf_collector/ebpf_collector.c      | 9 +++------
 1 file changed, 3 insertions(+), 6 deletions(-)

diff --git a/src/services/sentryCollector/ebpf_collector/ebpf_collector.c b/src/services/sentryCollector/ebpf_collector/ebpf_collector.c
index 50fff12..a54bf82 100644
--- a/src/services/sentryCollector/ebpf_collector/ebpf_collector.c
+++ b/src/services/sentryCollector/ebpf_collector/ebpf_collector.c
@@ -184,15 +184,12 @@ static int print_map_res(int fd, char *stage, int map_size, int *io_dump)
             logMessage(LOG_LEVEL_ERROR, "failed to lookup %s map_res: %d\n", stage, err);
             return -1; 
         }
-        
-        size_t length = strlen(counter.io_type);
-        char io_type;
-        if (length > 0) {
+
+        char io_type = counter.io_type[0];
+        if (io_type != '\0') {
             logMessage(LOG_LEVEL_DEBUG, "io_type have value.\n");
-            io_type = counter.io_type[0];
         } else {
             logMessage(LOG_LEVEL_DEBUG, "io_type not value.\n");
-            io_type = '\0';
         }
         int major = counter.major;
         int first_minor = counter.first_minor;
-- 

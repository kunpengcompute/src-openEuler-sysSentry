From d4ee6013cbcaf24afd1a0569aa3de35e766fc0d0 Mon Sep 17 00:00:00 2001
From: shixuantong <sxt1001@qq.com>
Date: Tue, 28 Jul 2026 10:30:26 +0800
Subject: [PATCH 3/9] Correct the misuse of compilation options

Fix details:
(1) -Wtrampolines is a compiler flag, not a linker flag.
(2) Add -g to selected component builds.
(3) Set compile flags via COMPILE_FLAGS rather than CMAKE_C_FLAGS."
---
 src/libsentry/c/log/CMakeLists.txt                 | 4 ++--
 src/sentryPlugins/bmc_ras_sentry/CMakeLists.txt    | 2 +-
 src/sentryPlugins/cpu_sentry/catlib/CMakeLists.txt | 4 ++--
 3 files changed, 5 insertions(+), 5 deletions(-)

diff --git a/src/libsentry/c/log/CMakeLists.txt b/src/libsentry/c/log/CMakeLists.txt
index 8208f723dbf1..87382d1b9f35 100644
--- a/src/libsentry/c/log/CMakeLists.txt
+++ b/src/libsentry/c/log/CMakeLists.txt
@@ -4,5 +4,5 @@ cmake_minimum_required(VERSION 3.22)
 project(sentry_log)
 add_library(sentry_log SHARED log_utils.c)
 set(CMAKE_VERBOSE_MAKEFILE ON)
-set_target_properties(sentry_log PROPERTIES LINK_FLAGS "-Wl,-z,relro -Wl,-z,now -Wl,-z,noexecstack -Wtrampolines")
-set_target_properties(sentry_log PROPERTIES CMAKE_C_FLAGS "-shared -fPIC -fstack-protector-strong -D_FORTIFY_SOURCE=2 -O2 -Wall -Werror -g")
+set_target_properties(sentry_log PROPERTIES LINK_FLAGS "-Wl,-z,relro -Wl,-z,now -Wl,-z,noexecstack")
+set_target_properties(sentry_log PROPERTIES COMPILE_FLAGS "-shared -fPIC -fstack-protector-strong -D_FORTIFY_SOURCE=2 -O2 -Wall -Werror -Wtrampolines -g")
diff --git a/src/sentryPlugins/bmc_ras_sentry/CMakeLists.txt b/src/sentryPlugins/bmc_ras_sentry/CMakeLists.txt
index 035dbb7982da..6431fb88235d 100644
--- a/src/sentryPlugins/bmc_ras_sentry/CMakeLists.txt
+++ b/src/sentryPlugins/bmc_ras_sentry/CMakeLists.txt
@@ -10,7 +10,7 @@ set(CMAKE_RUNTIME_OUTPUT_DIRECTORY ${CMAKE_SOURCE_DIR}/output)
 set(CMAKE_SKIP_BUILD_RPATH TRUE)
 set(CMAKE_SKIP_INSTALL_RPATH TRUE)
 
-set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} -fstack-protector-strong -D_FORTIFY_SOURCE=2 -O2 -Wall -Wtrampolines -fPIE")
+set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} -fstack-protector-strong -D_FORTIFY_SOURCE=2 -O2 -g -Wall -Wtrampolines -fPIE")
 set(CMAKE_EXE_LINKER_FLAGS "${CMAKE_EXE_LINKER_FLAGS} -Wl,-z,relro -Wl,-z,now -Wl,-z,noexecstack -pie")
 
 include_directories(
diff --git a/src/sentryPlugins/cpu_sentry/catlib/CMakeLists.txt b/src/sentryPlugins/cpu_sentry/catlib/CMakeLists.txt
index e2a002d44854..57d42eaf08df 100644
--- a/src/sentryPlugins/cpu_sentry/catlib/CMakeLists.txt
+++ b/src/sentryPlugins/cpu_sentry/catlib/CMakeLists.txt
@@ -24,8 +24,8 @@ target_sources(cat-cli PUBLIC ${CLI_SRC})
 # cpu_patrol以独立的so链接
 TARGET_LINK_LIBRARIES(cat-cli pthread -ldl  cpu_patrol)
 
-set_target_properties(cat-cli PROPERTIES LINK_FLAGS "-Wl,-z,relro -Wl,-z,now -Wl,-z,noexecstack -Wtrampolines")
-set_target_properties(cat-cli PROPERTIES COMPILE_FLAGS "-shared -fPIC -fstack-protector-strong -D_FORTIFY_SOURCE=2 -O2 -Wall -Werror -g")
+set_target_properties(cat-cli PROPERTIES LINK_FLAGS "-Wl,-z,relro -Wl,-z,now -Wl,-z,noexecstack")
+set_target_properties(cat-cli PROPERTIES COMPILE_FLAGS "-shared -fPIC -fstack-protector-strong -D_FORTIFY_SOURCE=2 -O2 -Wall -Werror -Wtrampolines -g")
 
 # 安装相关
 install(TARGETS cat-cli
-- 

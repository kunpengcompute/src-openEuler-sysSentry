             break; 
+        }
 
         int io_dump_bio[MAP_SIZE] = {0}; 
         update_io_dump(BIO_RES_2, io_dump_bio, device_count,"bio");
         err = print_map_res(BIO_RES, "bio", device_count, io_dump_bio); 
-        if (err) 

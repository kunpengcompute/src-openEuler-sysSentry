From f5137d01b75512dd782f04548c41414f8026dc95 Mon Sep 17 00:00:00 2001
From: shixuantong <shixuantong1@huawei.com>
Date: Wed, 18 Mar 2026 16:58:21 +0800
Subject: [PATCH 5/5] fix fd leaks in sentry_msg_monitor

---
 src/sentryPlugins/sentry_msg_monitor/sentry_msg_monitor.c | 1 +
 1 file changed, 1 insertion(+)

diff --git a/src/sentryPlugins/sentry_msg_monitor/sentry_msg_monitor.c b/src/sentryPlugins/sentry_msg_monitor/sentry_msg_monitor.c
index 844a186..a9b4a89 100644
--- a/src/sentryPlugins/sentry_msg_monitor/sentry_msg_monitor.c
+++ b/src/sentryPlugins/sentry_msg_monitor/sentry_msg_monitor.c
@@ -97,6 +97,7 @@ static int release_pid_file(int fd)
     int ret;
     ret = handle_file_lock(fd, false);
     if (ret < 0) {
+        close(fd);
         logging_error("release pid file %s lock failed, error msg is %s\n", PID_FILE_PATH, strerror(errno));
         return ret;
     }

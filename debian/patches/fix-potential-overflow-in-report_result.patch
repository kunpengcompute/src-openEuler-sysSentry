From: shixuantong <shixuantong1@huawei.com>
Date: Tue, 3 Feb 2026 14:13:36 +0800
Subject: [PATCH 1/4] fix potential overflow in report_result()

---
 src/libs/libxalarm/register_xalarm.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/src/libs/libxalarm/register_xalarm.c b/src/libs/libxalarm/register_xalarm.c
index 0309ae6..1fc57a7 100644
--- a/src/libs/libxalarm/register_xalarm.c
+++ b/src/libs/libxalarm/register_xalarm.c
@@ -630,7 +630,7 @@ int report_result(const char *task_name, enum RESULT_LEVEL result_level, const c
         goto free_json;
     }
 
-    char *message = (char *)calloc(RESULT_INFO_HEAD_LEN + RESULT_INFO_MAX_LEN, sizeof(char));
+    char *message = (char *)calloc(RESULT_INFO_HEAD_LEN + send_data_len + 1, sizeof(char));
     if (!message) {
         fprintf(stderr, "Failed to allocate memory!");
         goto free_json;

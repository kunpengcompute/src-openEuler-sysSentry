From cb9cb2bd3cc3731092207600136acde21aad23dd Mon Sep 17 00:00:00 2001
From: shixuantong <shixuantong1@huawei.com>
Date: Fri, 6 Mar 2026 15:42:34 +0800
Subject: [PATCH] fix the problem of checking the return value of the
 pthread_create()

---
 src/libs/libxalarm/register_xalarm.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/src/libs/libxalarm/register_xalarm.c b/src/libs/libxalarm/register_xalarm.c
index 90b5347..ee81a57 100644
--- a/src/libs/libxalarm/register_xalarm.c
+++ b/src/libs/libxalarm/register_xalarm.c
@@ -167,7 +167,7 @@ static pthread_t create_thread(void)
     pthread_t t_id = ULONG_MAX;
 
     ret = pthread_create(&t_id, NULL, alarm_recv, NULL);
-    if (ret < 0) {
+    if (ret != 0) {
         printf("create_thread: pthread_create error ret:%d\n", ret);
         t_id = ULONG_MAX;
     }

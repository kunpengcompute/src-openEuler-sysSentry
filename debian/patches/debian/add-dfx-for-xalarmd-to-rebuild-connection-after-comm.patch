diff --git a/config/service/xalarmd.service b/config/service/xalarmd.service
index 0665b39..20db997 100644
--- a/config/service/xalarmd.service
+++ b/config/service/xalarmd.service
@@ -2,8 +2,13 @@
 Description = xalarm daemon for alarm messages forwarding
  
 [Service]

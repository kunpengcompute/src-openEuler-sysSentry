Subject: [PATCH 5/6] fix the infinite loop for cleanup_thread thread

---
 src/services/xalarm/xalarm_server.py | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/src/services/xalarm/xalarm_server.py b/src/services/xalarm/xalarm_server.py
index f729366..97aa8a8 100644
--- a/src/services/xalarm/xalarm_server.py
+++ b/src/services/xalarm/xalarm_server.py
@@ -133,7 +133,7 @@ def period_task_to_cleanup_connections():
         sleep(PERIOD_SCANN_TIME)
         # if conn thread stopped, cleanup thread should not cleanup anymore
         if conn_thread_should_stop.is_set():
-            continue
+            break
         cleanup_closed_connections(alarm_sock, alarm_epoll, fd_to_socket, fd_to_socket_lock)
 
 

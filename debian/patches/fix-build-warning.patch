 src/sentryPlugins/soc_ring_sentry/tc_ring_one.c     | 4 ++--
 2 files changed, 3 insertions(+), 2 deletions(-)

diff --git a/src/sentryPlugins/sentry_msg_monitor/ub_fault_lib.c b/src/sentryPlugins/sentry_msg_monitor/ub_fault_lib.c
index 54f7e2d..1ac4892 100644

#!/bin/sh
set -e

if [ "$1" = "0" ]; then
    systemctl stop xalarmd.socket
    systemctl disable xalarmd.socket
    systemctl stop sysSentry.socket
    systemctl disable sysSentry.socket
    systemctl stop xalarmd.service
    systemctl disable xalarmd.service
    systemctl stop sysSentry.service
    systemctl disable sysSentry.service
fi

From 0a881665e8993ff8039bc426ad56231593e53a84 Mon Sep 17 00:00:00 2001
From: shixuantong <sxt1001@qq.com>
Date: Sat, 25 Jul 2026 08:34:16 +0800
Subject: [PATCH] fix codecheck warning

---
 src/libs/pyxalarm/register_xalarm.py    | 5 +++--
 src/services/syssentry/cron_process.py  | 2 ++
 src/services/syssentry/global_values.py | 3 ++-
 src/services/syssentry/sentryctl        | 1 -
 4 files changed, 7 insertions(+), 4 deletions(-)

diff --git a/src/libs/pyxalarm/register_xalarm.py b/src/libs/pyxalarm/register_xalarm.py
index 30f2af428278..8d4105fcd780 100644
--- a/src/libs/pyxalarm/register_xalarm.py
+++ b/src/libs/pyxalarm/register_xalarm.py
@@ -30,7 +30,7 @@ class AlarmRegister:
         self.thread_should_stop = False
 
     def check_params(self) -> bool:
-        if (len(self.id_filter) != MAX_NUM_OF_ALARM_ID):
+        if len(self.id_filter) != MAX_NUM_OF_ALARM_ID:
             sys.stderr.write("check_params: invalid param id_filter\n")
             return False
         
@@ -49,6 +49,7 @@ class AlarmRegister:
             sys.stderr.write("set_id_filter: invalid param id_filter\n")
             return False
         self.id_filter = id_filter
+        return True
 
     def id_is_registered(self, alarm_id) -> bool:
         if alarm_id < MIN_ALARM_ID or alarm_id > MAX_ALARM_ID:
@@ -72,7 +73,7 @@ class AlarmRegister:
             sock.setblocking(False)
             sock.connect(PATH_REG_ALARM)
             return sock
-        except (IOError, OSError, FileNotFoundError) as e:
+        except (IOError, OSError) as e:
             sock.close()
             sys.stderr.write(f"create_unix_socket: create socket error:{e}\n")
             return None
diff --git a/src/services/syssentry/cron_process.py b/src/services/syssentry/cron_process.py
index 21f3a9324c27..b4412d464634 100644
--- a/src/services/syssentry/cron_process.py
+++ b/src/services/syssentry/cron_process.py
@@ -137,6 +137,8 @@ class PeriodTask(InspectTask):
         res, _ = self.start()
         if res:
             set_runtime_status(self.name, RUNNING_STATUS)
+            return True
+        return False
 
 
 def period_tasks_handle():
diff --git a/src/services/syssentry/global_values.py b/src/services/syssentry/global_values.py
index 6c01087fa9b7..befd81767c04 100644
--- a/src/services/syssentry/global_values.py
+++ b/src/services/syssentry/global_values.py
@@ -22,7 +22,7 @@ import shlex
 from .result import ResultLevel, RESULT_LEVEL_ERR_MSG_DICT
 from .utils import get_current_time_string, run_cmd
 from .mod_status import set_runtime_status
-from .mod_status import RUNNING_STATUS, EXITED_STATUS, NONZERO_EXITED_STATUS, FAILED_STATUS, WAITING_STATUS
+from .mod_status import RUNNING_STATUS, EXITED_STATUS, NONZERO_EXITED_STATUS, FAILED_STATUS
 
 CTL_SOCKET_PATH = "/var/run/sysSentry/control.sock"
 SYSSENTRY_CONF_PATH = "/etc/sysSentry"
@@ -212,6 +212,7 @@ class InspectTask:
         if not res:
             return False
         set_runtime_status(self.name, RUNNING_STATUS)
+        return True
 
     def check_conflict(self):
         logging.debug("load_env_file detail, task_name: %s, conflict: %s, env_file: %s",
diff --git a/src/services/syssentry/sentryctl b/src/services/syssentry/sentryctl
index 6774524386f0..023a5a09c3b1 100644
--- a/src/services/syssentry/sentryctl
+++ b/src/services/syssentry/sentryctl
@@ -18,7 +18,6 @@ import argparse
 import json
 import sys
 import logging
-import json
 
 from syssentry.utils import MAX_MSG_LEN, recv_all
 

From: shixuantong <shixuantong1@huawei.com>
Date: Wed, 18 Mar 2026 14:32:19 +0800
Subject: [PATCH 1/5] fix fd leaks in get_socket_id()

---
 .../cpu_sentry/catlib/plugin/cpu_patrol/cpu_patrol_result.c    | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/src/sentryPlugins/cpu_sentry/catlib/plugin/cpu_patrol/cpu_patrol_result.c b/src/sentryPlugins/cpu_sentry/catlib/plugin/cpu_patrol/cpu_patrol_result.c
index 0a26b09..d7b6bd3 100644
--- a/src/sentryPlugins/cpu_sentry/catlib/plugin/cpu_patrol/cpu_patrol_result.c
+++ b/src/sentryPlugins/cpu_sentry/catlib/plugin/cpu_patrol/cpu_patrol_result.c
@@ -213,11 +213,12 @@ int get_socket_id(int core_id) {
     while (fgets(line, MAX_LINE_LEN, file) != NULL) {
         parse_string(line, id_pair, 2);
         if (id_pair[0] == core_id) {
+            pclose(file);
             return id_pair[1];
         }
     }
 
-    fclose(file);
+    pclose(file);
     return -1;
 }
 

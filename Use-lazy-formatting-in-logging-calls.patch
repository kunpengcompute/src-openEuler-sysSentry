From 6a476822efb3198d465b004ba32b3af3f4987587 Mon Sep 17 00:00:00 2001
From: shixuantong <sxt1001@qq.com>
Date: Thu, 3 Sep 2026 17:30:02 +0800
Subject: [PATCH] Use lazy % formatting in logging calls

Replace f-string/.format() with lazy % interpolation in debug
logging so string formatting is deferred until the record is
actually emitted (skipped entirely when the level is disabled):

- cpu_alarm.py: param count mismatch debug log
- alarm.py: alarm_list size and per-element timestamp debug logs
  (the latter runs inside a loop)
- bmc_alarm.py: raw BMC data debug log

Log levels and output content are unchanged.

Co-Authored-By: GLM-5.3
---
 src/sentryPlugins/cpu_sentry/cpu_alarm.py | 5 ++---
 src/services/syssentry/alarm.py           | 6 +++---
 src/services/syssentry/bmc_alarm.py       | 2 +-
 3 files changed, 6 insertions(+), 7 deletions(-)

diff --git a/src/sentryPlugins/cpu_sentry/cpu_alarm.py b/src/sentryPlugins/cpu_sentry/cpu_alarm.py
index 211060f91c37..9d87119d342e 100644
--- a/src/sentryPlugins/cpu_sentry/cpu_alarm.py
+++ b/src/sentryPlugins/cpu_sentry/cpu_alarm.py
@@ -77,9 +77,8 @@ def parser_cpu_alarm_info(req_data):
 
     if len(cpu_alarm_info) != CPU_ALARM_PARAM_LEN:
         logging.debug(
-            "expected {} params in fixed params, got {}".format(
-                CPU_ALARM_PARAM_LEN, len(cpu_alarm_info)
-            )
+            "expected %d params in fixed params, got %d",
+            CPU_ALARM_PARAM_LEN, len(cpu_alarm_info)
         )
         raise ValueError
 
diff --git a/src/services/syssentry/alarm.py b/src/services/syssentry/alarm.py
index 1f87fe7523cd..6c0da3b8a413 100644
--- a/src/services/syssentry/alarm.py
+++ b/src/services/syssentry/alarm.py
@@ -151,12 +151,12 @@ def get_alarm_result(task_name: str, time_range: int, detailed: bool):
             logging.debug("alarm_id does not exist")
             return []
         alarm_list = alarm_list_dict[alarm_id]
-        logging.debug(f"get_alarm_result: alarm_list of {alarm_id} has {len(alarm_list)} elements")
+        logging.debug("get_alarm_result: alarm_list of %s has %d elements", alarm_id, len(alarm_list))
         # clear alarm_info older than clear time threshold
         stop_index = -1
         timestamp = datetime.now().timestamp()
         for i in range(len(alarm_list)):
-            logging.debug(f"timestamp, alarm_list[{i}].timestamp: {timestamp}, {xalarm_gettime(alarm_list[i])}")
+            logging.debug("timestamp, alarm_list[%d].timestamp: %s, %s", i, timestamp, xalarm_gettime(alarm_list[i]))
             if timestamp - (xalarm_gettime(alarm_list[i])) / MILLISECONDS_UNIT_SECONDS > time_range:
                 stop_index = i
                 break
@@ -165,7 +165,7 @@ def get_alarm_result(task_name: str, time_range: int, detailed: bool):
                 break
         if stop_index >= 0:
             alarm_list = alarm_list[:stop_index]
-        logging.debug(f"get_alarm_result: final alarm_list of {alarm_id} has {len(alarm_list)} elements")
+        logging.debug("get_alarm_result: final alarm_list of %s has %d elements", alarm_id, len(alarm_list))
 
         def xalarm_to_dict(alarm_info: Xalarm) -> dict:
             timestamp = alarm_info.timetamp.tv_sec + alarm_info.timetamp.tv_usec / 1000000
diff --git a/src/services/syssentry/bmc_alarm.py b/src/services/syssentry/bmc_alarm.py
index 04a7fea42330..7675792bb032 100644
--- a/src/services/syssentry/bmc_alarm.py
+++ b/src/services/syssentry/bmc_alarm.py
@@ -69,7 +69,7 @@ def reverse_byte(data):
 
 
 def parse_hbmc_report(data: str):
-    logging.debug(f"bmc receive raw data is {data}")
+    logging.debug("bmc receive raw data is %s", data)
     repair_type = convert_hex_char_to_int(data, HBMC_REPAIR_TYPE_BIT)
     repair_type += HBMC_REPAIR_TYPE_OFFSET
     if not find_value_is_in_enum(repair_type, HBMCRepairType):
-- 

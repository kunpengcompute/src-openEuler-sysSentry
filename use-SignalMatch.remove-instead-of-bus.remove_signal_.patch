From 33bf784603a3cb1fa65c316afaff0cf80f7a14e9 Mon Sep 17 00:00:00 2001
From: shixuantong <sxt1001@qq.com>
Date: Thu, 13 Aug 2026 15:59:26 +0800
Subject: [PATCH] use SignalMatch.remove() instead of
 bus.remove_signal_receiver

Fixes: e76ddfe7179f ("Fix security issues in monitor_sentry_service function")
---
 src/services/xalarm/xalarm_server.py | 11 +++--------
 1 file changed, 3 insertions(+), 8 deletions(-)

diff --git a/src/services/xalarm/xalarm_server.py b/src/services/xalarm/xalarm_server.py
index a61d10ab425b..517922ad4495 100644
--- a/src/services/xalarm/xalarm_server.py
+++ b/src/services/xalarm/xalarm_server.py
@@ -203,7 +203,7 @@ def monitor_sentry_service():
             except Exception as e:
                 logging.error("Error in on_properties_changed callback: %s", str(e))
 
-        bus.add_signal_receiver(
+        signal_match = bus.add_signal_receiver(
             handler_function=on_properties_changed,
             signal_name='PropertiesChanged',
             dbus_interface='org.freedesktop.DBus.Properties',
@@ -226,13 +226,8 @@ def monitor_sentry_service():
         if bus is not None:
             try:
                 if signal_registered:
-                    bus.remove_signal_receiver(
-                        handler_function=on_properties_changed,
-                        signal_name='PropertiesChanged',
-                        dbus_interface='org.freedesktop.DBus.Properties',
-                        bus_name='org.freedesktop.systemd1',
-                        path='/org/freedesktop/systemd1/unit/sysSentry_2eservice'
-                    )
+                    signal_match.remove()
+                    logging.info("remove signal receiver success")
             except Exception as e:
                 logging.error("Failed to remove signal receiver: %s", str(e))
             finally:
-- 

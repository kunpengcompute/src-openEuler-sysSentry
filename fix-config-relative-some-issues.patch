         self.__absolute_threshold = ConfigParser.DEFAULT_ABSOLUTE_THRESHOLD
         self.__slow_io_detect_frequency = ConfigParser.DEFAULT_SLOW_IO_DETECTION_FREQUENCY
         self.__log_level = ConfigParser.DEFAULT_LOG_LEVEL

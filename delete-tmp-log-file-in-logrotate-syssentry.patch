From a5d87f28632db0b514070dff51d2d6dc2de2b6c8 Mon Sep 17 00:00:00 2001
From: shixuantong <shixuantong1@huawei.com>
Date: Thu, 6 Nov 2025 10:23:53 +0800
Subject: [PATCH] delete tmp log file in logrotate-syssentry

---
 src/libsentry/sh/log/logrotate-sysSentry.cron | 6 +-----
 1 file changed, 1 insertion(+), 5 deletions(-)

diff --git a/src/libsentry/sh/log/logrotate-sysSentry.cron b/src/libsentry/sh/log/logrotate-sysSentry.cron
index 4a761c1..2e86b4f 100644
--- a/src/libsentry/sh/log/logrotate-sysSentry.cron
+++ b/src/libsentry/sh/log/logrotate-sysSentry.cron
@@ -1,13 +1,9 @@
 #!/bin/sh
 
-TMPF=`mktemp /tmp/logrotate-sysSentry.XXXXXXXXX`
-
-/usr/sbin/logrotate /etc/sysSentry/logrotate-sysSentry.conf -v --log=$TMPF -s /var/lib/logrotate-syssentry/logrotate.status
+/usr/sbin/logrotate /etc/sysSentry/logrotate-sysSentry.conf -v -s /var/lib/logrotate-syssentry/logrotate.status
 EXITVALUE=$?
 if [ $EXITVALUE != 0 ]; then
 	/bin/logger -t logrotate "ALERT exited abnormally with [$EXITVALUE], for details, see /var/log/sysSentry/logrotate.log"
-	/bin/logger -t logrotate -f $TMPF
 fi
-rm -rf $TMPF
 rm -rf /var/lib/logrotate-syssentry/logrotate.status
 exit $EXITVALUE
-- 

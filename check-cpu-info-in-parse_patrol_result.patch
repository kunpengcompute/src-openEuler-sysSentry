From ab89eac2c8d09dcd865b0956e8b1c25718d3ff01 Mon Sep 17 00:00:00 2001
From: shixuantong <shixuantong1@huawei.com>
Date: Thu, 5 Feb 2026 15:06:50 +0800
Subject: [PATCH 14/17] check cpu info in parse_patrol_result()

---
 .../cpu_sentry/catlib/plugin/cpu_patrol/cpu_patrol_result.c  | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/src/sentryPlugins/cpu_sentry/catlib/plugin/cpu_patrol/cpu_patrol_result.c b/src/sentryPlugins/cpu_sentry/catlib/plugin/cpu_patrol/cpu_patrol_result.c
index c646bf1..5b45ced 100644
--- a/src/sentryPlugins/cpu_sentry/catlib/plugin/cpu_patrol/cpu_patrol_result.c
+++ b/src/sentryPlugins/cpu_sentry/catlib/plugin/cpu_patrol/cpu_patrol_result.c
@@ -6,6 +6,7 @@
 #include <stdlib.h>
 #include <errno.h>
 #include <stdbool.h>
+#include <limits.h>
 #include <xalarm/register_xalarm.h>
 
 #include "cat_structs.h"
@@ -82,6 +83,10 @@ static cat_return_t parse_patrol_result(char *buf, core_list_st *fault_list)
         if (coreid_after < 0) {
             insert_core_to_list(fault_list, coreid_before);
         } else {
+            if (coreid_before > coreid_after || coreid_before < 0 || coreid_after < 0 || coreid_after == INT_MAX) {
+                CAT_LOG_E("invalid cpu info: %d-%d\n", coreid_before, coreid_after);
+                return CAT_ERR;
+            }
             for (int i = coreid_before; i <= coreid_after; i++) {
                 insert_core_to_list(fault_list, i);
             }
-- 

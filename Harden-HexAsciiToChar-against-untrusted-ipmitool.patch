From 2100ea4c76103737a906689520b5ca9cc376e2a7 Mon Sep 17 00:00:00 2001
From: shixuantong <sxt1001@qq.com>
Date: Sat, 5 Sep 2026 14:38:32 +0800
Subject: [PATCH] Harden HexAsciiToChar against untrusted ipmitool output

HexAsciiToChar parses bytes from ipmitool output, which is untrusted
(BMC-controlled). The old std::stoul call had two problems:

- invalid input such as zz threw an uncaught invalid_argument that
  escaped the SentryWorker thread entry and terminated the whole
  daemon via std::terminate
- stoul tolerantly accepted inputs that are not two hex digits:
  leading whitespace, +/- signs, and the 0x prefix

Co-Authored-By: GLM-5.3
---
 src/sentryPlugins/bmc_ras_sentry/src/common.cpp | 11 +++++++++--
 1 file changed, 9 insertions(+), 2 deletions(-)

diff --git a/src/sentryPlugins/bmc_ras_sentry/src/common.cpp b/src/sentryPlugins/bmc_ras_sentry/src/common.cpp
index 94b9c83..d16e4a1 100644
--- a/src/sentryPlugins/bmc_ras_sentry/src/common.cpp
+++ b/src/sentryPlugins/bmc_ras_sentry/src/common.cpp
@@ -231,9 +231,16 @@ bool HexAsciiToChar(const std::string& hexStr, std::string& asciiStr)
         BMC_LOG_ERROR << "input str length for hex ascii to char must be 2, str: " << hexStr;
         return false;
     }
-    
+
+    // endPtr完整性检查: 确认整个字符串被完整消费, 防御strtoul的宽松解析
+    // (前导空白/正负号/部分解析取前缀值)在前置白名单被改动后静默失效
     uint8_t asciiVal = 0;
-    unsigned long temp = std::stoul(hexStr, nullptr, 16);
+    char* endPtr = nullptr;
+    unsigned long temp = std::strtoul(hexStr.c_str(), &endPtr, 16);
+    if (endPtr != hexStr.c_str() + hexStr.length()) {
+        BMC_LOG_ERROR << "input str is not fully consumed as hex, str: " << hexStr;
+        return false;
+    }
     if (temp > UINT8_MAX) {
         BMC_LOG_ERROR << "input str value out of 255, str: " << hexStr;
         return false;
-- 
2.45.0.windows.1


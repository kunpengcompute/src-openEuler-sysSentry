From 29346e4a8a6a67f9f33113e12977a5249d4c3e56 Mon Sep 17 00:00:00 2001
From: shixuantong <sxt1001@qq.com>
Date: Thu, 3 Sep 2026 17:33:29 +0800
Subject: [PATCH] Wrap long lines to keep line length within 120 chars

Formatting only, no behavior change.

Co-Authored-By: GLM-5.3
---
 src/sentryPlugins/ai_block_io/detector.py    | 17 +++++++++--------
 src/sentryPlugins/cpu_sentry/cpu_sentry.py   | 10 ++++++++--
 src/services/sentryCollector/collect_disk.py |  3 ++-
 3 files changed, 19 insertions(+), 11 deletions(-)

diff --git a/src/sentryPlugins/ai_block_io/detector.py b/src/sentryPlugins/ai_block_io/detector.py
index 96939f5..e980861 100644
--- a/src/sentryPlugins/ai_block_io/detector.py
+++ b/src/sentryPlugins/ai_block_io/detector.py
@@ -140,13 +140,14 @@ class DiskDetector:
         iodump_wins = {"read": {}, "write": {}}
         iops_wins = {"read": {}, "write": {}}
         for detector in self._detector_list:
+            io_type_name = detector.metric_name.io_access_type_name
+            io_stage_name = [detector.metric_name.stage_name
             if detector.metric_name.metric_name == 'latency':
-                latency_wins[detector.metric_name.io_access_type_name][detector.metric_name.stage_name] = detector.get_sliding_window_data()
+                latency_wins[io_type_name][io_stage_name] = detector.get_sliding_window_data()
             elif detector.metric_name.metric_name == 'io_dump':
-                iodump_wins[detector.metric_name.io_access_type_name][detector.metric_name.stage_name] = detector.get_sliding_window_data()
+                iodump_wins[io_type_name][io_stage_name] = detector.get_sliding_window_data()
             elif detector.metric_name.metric_name == 'iops':
-                iops_wins[detector.metric_name.io_access_type_name][detector.metric_name.stage_name] =\
-                      detector.get_sliding_window_data()
+                iops_wins[io_type_name][io_stage_name] = detector.get_sliding_window_data()
         return latency_wins, iodump_wins, iops_wins
 
     def get_data_detector_list_window(self):
@@ -154,12 +155,12 @@ class DiskDetector:
         iodump_data_wins = {"read": {}, "write": {}}
         disk_data_wins = {"read": {}, "write": {}}
         for data_detector in self._data_detector_list:
+            io_type_name = data_detector.metric_name.io_access_type_name
+            io_stage_name = data_detector.metric_name.stage_name
             if data_detector.metric_name.metric_name == 'iodump_data':
-                iodump_data_wins[data_detector.metric_name.io_access_type_name][data_detector.metric_name.stage_name] =\
-                      data_detector.get_data_window_data()
+                iodump_data_wins[io_type_name][io_stage_name] = data_detector.get_data_window_data()
             if data_detector.metric_name.metric_name == 'disk_data':
-                disk_data_wins[data_detector.metric_name.io_access_type_name][data_detector.metric_name.stage_name] =\
-                      data_detector.get_data_window_data()
+                disk_data_wins[io_type_name][io_stage_name] = data_detector.get_data_window_data()
         win_data_wins['iodump_data'] = iodump_data_wins
         win_data_wins['disk_data'] = disk_data_wins
         return win_data_wins
diff --git a/src/sentryPlugins/cpu_sentry/cpu_sentry.py b/src/sentryPlugins/cpu_sentry/cpu_sentry.py
index dbfc4bb..488488a 100644
--- a/src/sentryPlugins/cpu_sentry/cpu_sentry.py
+++ b/src/sentryPlugins/cpu_sentry/cpu_sentry.py
@@ -144,10 +144,16 @@ class CpuSentry:
             self.send_result["details"]["msg"] = "Some CPUs are faulty. The faulty cores are isolated successfully."
         else:
             found_fault_cores_set = set(found_fault_cores_list)
-            isolated_cpu_set = set(CpuSentry.cpu_format_convert_to_list(self.send_result["details"]["isolated_cpu_list"]))
+            isolated_cpu_set = set(CpuSentry.cpu_format_convert_to_list(
+                self.send_result["details"]["isolated_cpu_list"])
+            )
             self.send_result["details"]["code"] = 1002
             self.send_result["result"] = ResultLevel.MINOR_ALM
-            self.send_result["details"]["msg"] = "Some cores are isolated successfully and some cores ({}) fail to be isolated.".format(list(found_fault_cores_set - isolated_cpu_set))
+            self.send_result["details"]["msg"] = (
+                "Some cores are isolated successfully and some cores ({}) fail to be isolated.".format(
+                    list(found_fault_cores_set - isolated_cpu_set)
+                )
+            )
 
     def cpu_report_result(self):
         """report result to sysSentry"""
diff --git a/src/services/sentryCollector/collect_disk.py b/src/services/sentryCollector/collect_disk.py
index 03eda85..15b34dd 100644
--- a/src/services/sentryCollector/collect_disk.py
+++ b/src/services/sentryCollector/collect_disk.py
@@ -141,7 +141,8 @@ class CollectDisk:
             major_version = struct.unpack('<I', data[0:4])[0]
             minor_version = struct.unpack('<I', data[4:8])[0]
             if major_version != 1 or minor_version != 0:
-                logging.warning(f"Disk {self.disk_name} NVMe log version is {major_version}.{minor_version}, expected 1.0.")
+                logging.warning("Disk %s NVMe log version is %s.%s, expected 1.0.",
+                                self.disk_name, major_version, minor_version)
                 return False
             return True
         except Exception as e:
-- 

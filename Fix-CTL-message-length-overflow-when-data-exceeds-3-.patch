From 308afa4950a9329a9757697ee9c4192ff72d56dd Mon Sep 17 00:00:00 2001
From: shixuantong <sxt1001@qq.com>
Date: Thu, 16 Jul 2026 09:47:04 +0800
Subject: [PATCH] Fix CTL message length overflow when data exceeds 3 digits

When sentryctl set command uses --server_eid and --server_cna, the
total data length can exceed 999 bytes (4 digits). However, the CTL
message protocol uses a 3-digit length field (zfill(3)), causing both
the client encoding and server parsing to fail for data lengths >= 1000.

Changes:
- Expand CTL message length field width from 3 to 4 digits
  (CTL_MSG_LEN_LEN 3 -> 4)
- Expand CTL message header total length from 6 to 7 bytes
  (CTL_MSG_HEAD_LEN 6 -> 7, i.e. magic 3 + len 4)
- Fix server msg_head_process slice: use CTL_MSG_MAGIC_LEN as start
  index instead of CTL_MSG_LEN_LEN, which would incorrectly skip the
  first character of the 4-digit length field

Protocol format change: CTL{3-digit len}{data} -> CTL{4-digit len}{data}

Fixes: 0ea145bdc7db ("refact sentryctl set cmd")
---
 src/services/syssentry/sentryctl    | 23 +++++++++++++++--------
 src/services/syssentry/syssentry.py |  8 ++++----
 2 files changed, 19 insertions(+), 12 deletions(-)

diff --git a/src/services/syssentry/sentryctl b/src/services/syssentry/sentryctl
index 40178b9f30c0..78f911c03381 100644
--- a/src/services/syssentry/sentryctl
+++ b/src/services/syssentry/sentryctl
@@ -34,8 +34,9 @@ MAX_KERNEL_REBOOT_TIMEOUT_MS = 3600000
 MIN_CLIENT_JETTY_ID = 3
 MAX_CLIENT_JETTY_ID = 1023
 
+CTL_HEAD_MSG_DATA_DEFAULT_LEN = 4
+CTL_RESPONSE_DATA_DEFAULT_LEN = 3
 RESULT_MSG_DATA_LEN = 4
-CTL_MSG_LEN_LEN = 3
 ALARM_MSG_DATA_LEN = 6
 DEFAULT_ALARM_TIME_RANGE = 10
 
@@ -102,15 +103,21 @@ def client_send_and_recv(request_data, data_str_len):
 
     # msg: CTL{len}{data}
     req_data_len = len(request_data)
-    request_msg = "CTL" + str(req_data_len).zfill(3) + request_data
+    req_head_msg = "CTL" + str(req_data_len).zfill(CTL_HEAD_MSG_DATA_DEFAULT_LEN)
+    if len(req_head_msg) > len("CTL") + CTL_HEAD_MSG_DATA_DEFAULT_LEN:
+        client_socket.close()
+        print("The request message sent by the sentryctl command exceeds the length limit")
+        return None
+
+    request_msg = req_head_msg + request_data
 
     try:
         client_socket.send(request_msg.encode())
         if len("CTL") + data_str_len > MAX_MSG_LEN:
             client_socket.close()
-            logging.error("socket recv data is illegal:%d", len("CTL") + data_str_len)
+            print("socket recv data is illegal: %d" % (len("CTL") + data_str_len))
             return None
-        res_data = client_socket.recv(len("CTL") + data_str_len)
+        res_data = client_socket.recv(len("RES") + data_str_len)
         res_data = res_data.decode()
     except (OSError, UnicodeError):
         client_socket.close()
@@ -118,17 +125,17 @@ def client_send_and_recv(request_data, data_str_len):
         return None
 
     # res: RES{len}{data}
-    res_magic = res_data[:3]
+    res_magic = res_data[:len("RES")]
     if res_magic != "RES":
         client_socket.close()
         print("res msg format error")
         return None
 
     try:
-        res_data_len = int(res_data[3:])
+        res_data_len = int(res_data[len("RES"):])
         if res_data_len > MAX_MSG_LEN:
             client_socket.close()
-            logging.error("socket recv data is illegal:%d", res_data_len)
+            print("socket recv data is illegal:%d" % res_data_len)
             return
         res_msg_data = client_socket.recv(res_data_len)
         res_msg_data = res_msg_data.decode()
@@ -240,7 +247,7 @@ if __name__ == '__main__':
     elif client_args.cmd_type == 'get_alarm':
         result_message = client_send_and_recv(request_message, ALARM_MSG_DATA_LEN)
     else:
-        result_message = client_send_and_recv(request_message, CTL_MSG_LEN_LEN)
+        result_message = client_send_and_recv(request_message, CTL_RESPONSE_DATA_DEFAULT_LEN)
     if not result_message:
         print("sentryctl: client_send_and_recv failed")
         sys.exit(-1)
diff --git a/src/services/syssentry/syssentry.py b/src/services/syssentry/syssentry.py
index fba70b3986bd..2e3d7c30152e 100644
--- a/src/services/syssentry/syssentry.py
+++ b/src/services/syssentry/syssentry.py
@@ -62,12 +62,12 @@ except ImportError:
 
 exit_flag = False
 
-CTL_MSG_HEAD_LEN = 6
+CTL_MSG_HEAD_LEN = 7
 CTL_MSG_MAGIC_LEN = 3
-CTL_MSG_LEN_LEN = 3
 CTL_MAGIC = "CTL"
 RES_MAGIC = "RES"
 ALARM_MSG_DATA_LEN = 6
+CTL_RESPONSE_DATA_DEFAULT_LEN = 3
 
 CTL_LISTEN_QUEUE_LEN = 5
 SERVER_EPOLL_TIMEOUT = 0.3
@@ -262,7 +262,7 @@ def msg_head_process(msg_head):
         logging.error("recv msg head magic invalid: %s", ctl_magic)
         return -1
 
-    data_len_str = msg_head[CTL_MSG_LEN_LEN:CTL_MSG_HEAD_LEN]
+    data_len_str = msg_head[CTL_MSG_MAGIC_LEN:CTL_MSG_HEAD_LEN]
     try:
         data_len = int(data_len_str)
     except ValueError:
@@ -343,7 +343,7 @@ def server_recv(server_socket: socket.socket):
     elif cmd_type == "get_alarm":
         res_data_len = str(len(res_data)).zfill(ALARM_MSG_DATA_LEN)
     else:
-        res_data_len = str(len(res_data)).zfill(CTL_MSG_MAGIC_LEN)
+        res_data_len = str(len(res_data)).zfill(CTL_RESPONSE_DATA_DEFAULT_LEN)
     res_head += res_data_len
     logging.debug("res head %s", res_head)
 
-- 
2.43.0

